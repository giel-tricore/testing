<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="rental_product_inherit" inherit_id="website_sale_renting.rental_product">
        <xpath expr="//div[@id='rentingDates']" position="after">
            <table class="o_not_editable table w-70" id="">
                <tbody>
                    <t t-foreach="product.product_pricing_ids" t-as="pricing_info">
                        <tr>
                            <td>
                                <span class="oe_radio_input">
                                    <input type="radio"
                                           t-att-name="'pricing_info_option'"
                                           t-att-id="pricing_info.recurrence_id.id"
                                           t-att-value="pricing_info.recurrence_id.id"
                                           t-att-title="pricing_info.recurrence_id.name"
                                           t-att-data-duration='pricing_info.recurrence_id.duration'
                                           />
                                </span>
                                <label t-esc="pricing_info.recurrence_id.name"/>
                                <t t-set="rental_start_time" t-value="float(pricing_info.recurrence_id.rental_start_time or 0)"/>
                                <t t-set="start_minutes" t-value="int(rental_start_time * 60 // 60)"/>
                                <t t-set="start_seconds" t-value="int(rental_start_time * 60 % 60)"/>
                                <t t-set="rental_end_time" t-value="float(pricing_info.recurrence_id.rental_end_time or 0)"/>
                                <t t-set="end_minutes" t-value="int(rental_end_time * 60 // 60)"/>
                                <t t-set="end_seconds" t-value="int(rental_end_time * 60 % 60)"/>
                                <span>(<t t-esc="'{:02}:{:02}'.format(start_minutes, start_seconds)"/> - <t t-esc="'{:02}:{:02}'.format(end_minutes, end_seconds)"/>)</span>
                                <span class="availability-status">
                                    <i class="text-success d-none" t-att-data-value="pricing_info.recurrence_id.rental_time">Available</i>
                                    <i class="text-danger d-none" t-att-data-value="pricing_info.recurrence_id.rental_time">Not Available</i>
                                </span>
                            </td>
                            <td>
                                <span><t t-esc="pricing_info.price" t-options="{'widget': 'monetary', 'display_currency': pricing_info.currency_id}"/></span>
                            </td>
                        </tr>
                    </t>
                </tbody>
            </table>

            <t t-set="date_info" t-value="product.getDateInfo()"/>
            <i class='d-none get_date_info' t-att-data-date_info='date_info'></i>
        </xpath>
        
