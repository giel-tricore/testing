<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="sale_temporal_recurrence_view_form_inherit_arc_rental" model="ir.ui.view">
        <field name="name">sale.temporal.recurrence.view.form.inherit</field>
        <field name="model">sale.temporal.recurrence</field>
        <field name="inherit_id" ref="sale_renting.sale_temporal_recurrence_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='unit']" position="after">
                <field name="rental_time" />
                <field name="rental_start_time" widget="float_time" string="From"/>
                <field name="rental_end_time" widget="float_time" string="To"/>
            </xpath>
        </field>
    </record>
</odoo>